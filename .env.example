# IBM Quantum Cloud credentials template
# Copy this file to .env and fill in your real values.
# Get your API key from: https://quantum.cloud.ibm.com (Dashboard -> API keys)
IBM_QUANTUM_TOKEN=YOUR_IBM_QUANTUM_API_KEY_HERE

# Instance CRN (optional)
# IBM_QUANTUM_INSTANCE=crn:v1:bluemix:public:quantum-computing:...
